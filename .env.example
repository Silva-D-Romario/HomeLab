# ==================== CONFIGURAÇÕES GERAIS ====================
# PUID e PGID: ID do usuário/grupo no host (default: 1000)
PUID=1000
PGID=1000

# Fuso horário (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Sao_Paulo

# ==================== QBITTORRENT ====================
# (Opcional) Se quiser proteger a interface web
# WEBUI_USER=admin
# WEBUI_PASSWORD=mude_esta_senha

# ==================== JELLYSEERR ====================
# Nível de log: debug, info, warn, error
LOG_LEVEL=info

# ==================== JELLYFIN ====================
# (Sem variáveis sensíveis por padrão)

# ==================== OUTROS SERVIÇOS ====================
# (Cada serviço tem suas próprias variáveis, mas não são obrigatórias)